# 이 파일을 복사해 .env.local 로 저장하고 실제 키를 넣으세요. .env.local 은 git에 올라가지 않습니다.
# 서버에서만 읽는 키라서 NEXT_PUBLIC_ 접두사를 붙이지 않습니다 (명세서 17장: API Key 서버 측 보관).

# 오픈다트 인증키 (opendart.fss.or.kr > 인증키 신청/관리)
OPENDART_API_KEY=

# 한국은행 ECOS 인증키 (ecos.bok.or.kr > 개발 가이드 > 인증키 신청)
ECOS_API_KEY=

# KRX Open API 인증키 (openapi.krx.co.kr > 마이페이지 > API 인증키)
# 키 발급 후 'KOSPI 시리즈 일별시세정보', 'KOSDAQ 시리즈 일별시세정보' 서비스 이용 신청과 승인이 필요합니다.
KRX_API_KEY=
